PKG_CXXFLAGS = -DRCPP_PARALLEL_USE_TBB=1 -DHLSLPP_FEATURE_TRANSFORM \
  -I../inst/include \
  -I../inst/include/hlsl++ \
  -I../inst/include/hlsl++/platforms \
  -I../inst/include/hlsl++/swizzle \
  -I../inst/include/hlsl++/transform
PKG_LIBS += $(shell "${R_HOME}/bin${R_ARCH_BIN}/Rscript.exe" \
              -e "RcppParallel::RcppParallelLibs()")
